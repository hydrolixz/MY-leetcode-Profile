class Solution(object):
    def plusOne(self, digits):
        for i in range(len(digits)):
            if digits[len(digits)-(i+1)]==9:
                 digits[len(digits)-(i+1)]=0
            elif digits[len(digits)-(i+1)]!=9:
                digits[len(digits)-(i+1)]+=1
                break
        if digits[0]==0:
            digits[0]=1
            digits.append(0)
        return digits


