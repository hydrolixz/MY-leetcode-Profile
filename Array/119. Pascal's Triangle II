class Solution(object):
    def getRow(self, rowIndex):
        y=[[1]]
        for i in range(1,rowIndex+1):
            x=[0]*(i+1)
            for j in range(i+1):
                if j==0 or j==i:
                    x[j]=1
                else:
                    x[j]=y[i-1][j-1]+y[i-1][j]
            y.append(x)
        return y[-1]

        
