class Solution(object):
    def generate(self, numRows):
        y=[[1]]
        for i in range(1,numRows):
            x=[0]*(i+1)
            for j in range(len(x)):
                if j==0 or j==len(x)-1:
                    x[j]=1
                else:
                    x[j]=y[i-1][j-1]+y[i-1][j]
            y.append(x)
        return y
