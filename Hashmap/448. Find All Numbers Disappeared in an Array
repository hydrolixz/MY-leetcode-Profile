class Solution(object):
    def findDisappearedNumbers(self, nums):
        x=[x for x in range(1,len(nums)+1)]
        d={}
        for char in x:
            d[char]=0
        for char in nums:
            d[char]+=1
        z=[]
        for key,values in d.items():
             if values==0:
                z.append(key)
        return sorted(z)