class Solution(object):
    def mergeAlternately(self, word1, word2):
       s=[]
       if len(word2)>len(word1):
         for i in range(len(word1)):
            s.append(word1[i])
            s.append(word2[i])
         s.append(word2[len(word1):])
       else:
         for i in range(len(word2)):
            s.append(word1[i])
            s.append(word2[i])
         s.append(word1[len(word2):])
       x=''.join(s)
       return x