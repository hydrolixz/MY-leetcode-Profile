class Solution(object):
    def merge(self, nums1, m, nums2, n):
        y=n-1
        x=m+n-1
        z=m-1
        while z>=0 and y>=0:
            if nums1[z]<nums2[y]:
                nums1[x]=nums2[y]
                y-=1
                x-=1
            else:
                nums1[x]=nums1[z]
                x-=1
                z-=1
        while y>=0:
                nums1[x]=nums2[y]
                y-=1
                x-=1
            
        return nums1

        
        
        
