class Solution(object):
    def moveZeroes(self, nums):
        k=0
        y=0
        for char in nums:
            if char==0:
                k+=1
        for i in range(len(nums)):
            if nums[i]!=0:
                nums[y]=nums[i]
                y+=1
        for i in range(k):
            nums[i+y]=0
        return nums

        