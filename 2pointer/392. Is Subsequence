class Solution(object):
    def isSubsequence(self, s, t):
       x=0
       y=0
       if s=="":
        return True
       for i in range(len(t)):
         if s[x]==t[y]:
            x+=1
            y+=1
            if x==len(s):
                break
         else:
            y+=1
       return x==len(s)
        