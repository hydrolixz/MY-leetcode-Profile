class Solution(object):
    def judgeCircle(self, moves):
        x=[0,0]
        for char in moves:
            if char=="U":
                x[0]+=1
            elif char=="D":
                x[0]-=1
            elif char=="L":
                x[1]-=1
            elif char=="R":
                x[1]+=1
        if x[0]==0 and x[1]==0:
            return True
        else:
            return False
